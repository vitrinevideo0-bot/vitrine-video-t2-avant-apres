  "audio_profile": "afrobeat_restaurants_maquis",
  "music_selection_contract": "config/T2_music_pool_v1_0_0.json",
  "non_destructive_base": {
    "runtime_v0_3": "config/T2_runtime_contract_v0_3_0.json",
    "visual_v0_3_release": "t2-avant-apres-v0.3.0-text-motion",
    "visual_video_stream_sha256": "2ed8b3813410df8b9497da7b00877b208bed115038965f73989f00550d3941f5",
    "visual_logic_changed": false,
    "music_changed": true,
    "voice_speed_changed": false,
    "runtime_v0_6": "config/T2_runtime_contract_v0_6_0.json",
    "music_change_reason": "owner approved Naija Flow, Savanna Beats and Vibe Republic with retained Afrofire; historical A/B/C remain rejected",
    "runtime_v0_7": "config/T2_runtime_contract_v0_7_0.json"
  },
  "reference": {
    "repository": "https://github.com/j9028379-hue/vitrine-video-t1-pilot",
    "commit": "c656510ab81d31d413dc4dfd74b42671532cd978",
    "mode": "read_only_architecture_reference",
    "ported_mechanics": [
      "explicit 12-screen state machine",
      "complete capture media metadata",
      "music and voice attachment to the same plan",
      "RenderResult and RenderError contracts",
      "server-side immutable reference verification"
    ]
  },
  "runtime_order": [
    {
      "step": 1,
      "id": "MERCHANT_INPUT",
      "consumes": "six merchant answers",
      "produces": "merchant_payload"
    },
    {
      "step": 2,
      "id": "GUIDED_CAPTURE",
      "consumes": "camera plus optional microphone",
      "produces": [
        "captures.S1",
        "captures.S2",
        "captures.S3",
        "captures.S4"
      ],
      "contract": "config/T2_capture_flow_v1_0_0.json",
      "stable_screens": 12
    },
    {
      "step": 3,
      "id": "UNIFIED_RENDER_JOB",
      "consumes": [
        "merchant_payload",
        "four accepted captures",
        "auto or explicit owner-approved A/B/C/D music request",
        "last_successful_music_id",
        "voice source mode"
      ],
      "produces": "RenderJob schema 1.1.0"
    },
    {
      "step": 4,
      "id": "DETERMINISTIC_VISUAL_RENDER",
      "consumes": "the same RenderJob",
      "produces": "silent visual intermediate with dynamic merchant fields"
    },
    {
      "step": 5,
      "id": "VOICE_MUSIC_DUCKING",
      "consumes": [
        "the same RenderJob",
        "registered or accepted captured voice",
        "locked selected source from owner-approved A/B/C/D pool"
      ],
      "produces": "single complete MP4"
    },
    {
      "step": 6,
      "id": "QC_RESULT_RELEASE",
      "consumes": [
        "single MP4",
        "job hash",
        "input hashes"
      ],
      "produces": [
        "RenderResult",
        "objective QC",
        "GitHub artifact or Release"
      ]
    }
  ],
  "merchant_bindings": [
    {
      "source": "merchant_payload.nom",
      "targets": [
        "T2_G01_IDENTITY",
        "T2_G03_REVEAL",
        "T2_G04_FINAL"
      ]
    },
    {
      "source": "merchant_payload.produit",
      "targets": [
        "T2_G01_IDENTITY",
        "T2_G02_OFFER",
        "T2_G04_FINAL"
      ]
    },
    {
      "source": "merchant_payload.prix",
      "targets": [
        "T2_G02_OFFER",
        "T2_G04_FINAL"
      ]
    },
    {
      "source": "merchant_payload.whatsapp",
      "targets": [
        "T2_G04_FINAL"
      ]
    },
    {
      "source": "merchant_payload.quartier",
      "targets": [
        "T2_G04_FINAL"
      ]
    },
    {
      "source": "merchant_payload.accroche",
      "targets": [
        "T2_G03_REVEAL"
      ]
    }
  ],
  "capture_bindings": [
    {
      "source": "captures.S1.uri",
      "scene": "S1",
      "duration_ms": 6000,
      "timeline_start_ms": 0,
      "source_time_map": "identity",
