  ],
  "audio_handoff": {
    "voice_modes": [
      "registered_voice_clips",
      "captured_scene_audio",
      "captured_or_registered_fallback"
    ],
    "selected_exemplar_mode": "registered_voice_clips",
    "source_speed": 1.0,
    "audio_time_map": "identity",
    "automatic_subtitles": false,
    "music_candidate_for_this_exemplar": "B",
    "music_template_default": false,
    "music_source_sha256": "1f137af6975816230a2a56b5995d23cf162cfe1256422675cb4b1c0638d1d3ec",
    "ducking": {
      "open_gain_db": -3.0,
      "under_voice_gain_db": -10.0,
      "attack_ms": 120,
      "release_ms": 450
    },
    "source_audio_publish": false,
    "fallback_speech_gate": {
      "applies_to": "captured_or_registered_fallback",
      "minimum_active_speech_s": 0.35,
      "minimum_peak_dbfs": -42.0,
      "fallback": "registered clip for the same scene when accepted capture has no usable speech"
    }
  },
  "server_handoff": {
    "control_planes": [
      "github_actions_manual",
      "cloudflare_worker"
    ],
    "render_plane": "GitHub Actions only",
    "cloudflare_role": "validate, store captures and jobs, enforce idempotency, dispatch GitHub, receive result callback",
    "cloudflare_never_renders_video": true,
    "workflow": ".github/workflows/server-render-unified.yml",
    "security": {
      "client_mutations": "Bearer CLIENT_API_TOKEN",
      "github_callback_and_materialization": "Bearer CALLBACK_TOKEN",
      "capture_integrity": "client SHA-256 checked by R2 then checked again on GitHub",
      "idempotency": "conditional R2 claim by Idempotency-Key"
    },
    "result_contract": "schemas/render_result.schema.json",
    "error_contract": "schemas/render_error.schema.json"
  },
  "acceptance_gates": [
    "the complete mixer receives the same RenderJob that supplied merchant_payload and captures",
    "visual rendering is rebuilt from that job and remains exactly 900 frames",
    "music B and the four registered voices remain byte-locked for the reference exemplar",
    "captured audio, when selected, remains at identity speed 1x",
    "music source hash is checked before mixing",
    "RenderResult contains the job hash and all input hashes",
    "one MP4 and no standalone source audio are published",
    "all production rendering occurs on GitHub Actions"
  ],
  "capture_runtime": {
    "application": "cloudflare/public/app.js",
    "contract_endpoint": "/v1/contracts/capture-flow",
    "form_endpoint": "/v1/contracts/form",
    "stable_screens": 12,
    "countdown_transient": true,
    "camera_and_microphone": true,
    "review_audio_at_1x": true,
    "retake_supported": true,
    "accepted_media_types": [
      "video/mp4",
      "video/webm",
      "video/quicktime"
    ],
    "storage": "Cloudflare R2 until GitHub materialization"
  }
