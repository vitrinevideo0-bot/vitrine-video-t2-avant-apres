{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrine-video.example/schemas/T2_music_pool_v1_0_0.schema.json",
  "title": "T2 owner-approved four-track production pool",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "template_id",
    "status",
    "approved_on",
    "approval_contract",
    "historical_shortlist",
    "provider",
    "license",
    "license_url",
    "selection_contract",
    "publication_contract",
    "candidates"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/T2_music_pool_v1_0_0.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "const": "restaurants_maquis_T2_music_pool_v1_0_0"
    },
    "template_id": {
      "const": "restaurants_maquis_T2_avant_apres_v0_1_0"
    },
    "status": {
      "const": "all_four_owner_approved_for_rotation"
    },
    "approved_on": {
      "const": "2026-11-18"
    },
    "approval_contract": {
      "const": "approvals/T2_MUSIC_POOL_APPROVAL_2026-11-18.json"
    },
    "historical_shortlist": {
      "const": "music/T2_music_shortlist_v0_4_0.json"
    },
    "provider": {
      "const": "Pixabay"
    },
    "license": {
      "const": "Pixabay Content License"
    },
    "license_url": {
      "const": "https://pixabay.com/service/license-summary/"
    },
    "selection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "allowed_candidate_ids",
        "default_request",
        "automatic_algorithm",
        "no_immediate_repeat",
        "explicit_repeat_policy",
        "explicit_selection_policy",
        "state_key",
        "idempotency_ledger_key",
        "state_update_policy",
        "failed_render_state_policy",
        "persistent_state_schema",
        "cloudflare_state_object",
        "first_render_pool",
        "subsequent_pool_size"
      ],
      "properties": {
        "candidate_count": {
          "const": 4
        },
        "allowed_candidate_ids": {
          "const": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "default_request": {
          "const": "auto"
        },
        "automatic_algorithm": {
          "const": "strict approved order A→B→C→D→A from last successful music"
        },
        "no_immediate_repeat": {
          "const": true
        },
        "explicit_repeat_policy": {
          "const": "reject"
        },
        "explicit_selection_policy": {
          "const": "exact_successor_only"
        },
        "state_key": {
          "const": "last_successful_music_id"
        },
        "idempotency_ledger_key": {
          "const": "successful_render_jobs"
        },
        "state_update_policy": {
          "const": "after_success_only"
        },
        "failed_render_state_policy": {
          "const": "unchanged"
        },
        "persistent_state_schema": {
          "const": "schemas/T2_music_selection_state.schema.json"
        },
        "cloudflare_state_object": {
          "const": "music/t2-last-success.json"
        },
        "first_render_pool": {
          "const": "candidate_A_only"
        },
        "subsequent_pool_size": {
          "const": 1
        }
      }
    },
    "publication_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_pixabay_sources_bundled",
        "source_audio_publish",
        "adapted_30s_instrumentals_bundled",
        "instrumentals_contain_voice",
        "historical_auditions_are_production_assets",
        "standalone_music_release_forbidden"
      ],
      "properties": {
        "full_pixabay_sources_bundled": {
          "const": false
        },
        "source_audio_publish": {
          "const": false
        },
        "adapted_30s_instrumentals_bundled": {
          "const": true
        },
        "instrumentals_contain_voice": {
          "const": false
        },
        "historical_auditions_are_production_assets": {
          "const": false
        },
        "standalone_music_release_forbidden": {
          "const": true
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "properties": {
                "id": {
                  "const": "A"
                },
                "choice": {
                  "const": "1"
                },
                "pixabay_id": {
                  "const": 300340
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "properties": {
                "id": {
                  "const": "B"
                },
                "choice": {
                  "const": "2"
                },
                "pixabay_id": {
                  "const": 293956
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "properties": {
                "id": {
                  "const": "C"
                },
                "choice": {
                  "const": "3"
                },
                "pixabay_id": {
                  "const": 300333
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "properties": {
                "id": {
                  "const": "D"
                },
                "choice": {
                  "const": "4"
                },
                "pixabay_id": {
                  "const": 328624
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "choice",
        "pixabay_id",
        "title",
        "artist",
        "source_page",
        "source_audio_url",
        "source_sha256",
        "source_bytes",
        "source_duration_s",
        "source_start_s",
        "source_page_checked_on",
        "content_id_status",
        "ai_generated_badge",
        "owner_approved",
        "production_eligible",
        "file",
        "sha256",
        "bytes",
        "duration_s",
        "sample_rate_hz",
        "channels",
        "bitrate_kbps",
        "integrated_lufs",
        "true_peak_dbtp",
        "contains_voice",
        "mix_config",
        "mix_config_sha256",
        "production_output_file"
      ],
      "properties": {
        "id": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "choice": {
          "enum": [
            "1",
            "2",
            "3",
            "4"
          ]
        },
        "pixabay_id": {
          "enum": [
            300340,
            293956,
            300333,
            328624
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string",
          "minLength": 1
        },
        "source_page": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://pixabay\\.com/music/"
        },
        "source_audio_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://cdn\\.pixabay\\.com/(audio|download/audio)/"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 100000
        },
        "source_duration_s": {
          "type": "number",
          "minimum": 30
        },
        "source_start_s": {
          "type": "number",
          "minimum": 0
        },
        "source_page_checked_on": {
          "type": "string",
          "format": "date"
        },
        "content_id_status": {
          "const": "not_displayed_on_source_page"
        },
        "ai_generated_badge": {
          "enum": [
            "displayed",
            "not_displayed"
          ]
        },
        "owner_approved": {
          "const": true
        },
        "production_eligible": {
          "const": true
        },
        "file": {
          "type": "string",
          "pattern": "^audio/music/t2-afrobeat-v1/.*_30s\\.mp3$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 100000
        },
        "duration_s": {
          "const": 30.0
        },
        "sample_rate_hz": {
          "const": 48000
        },
        "channels": {
          "const": 2
        },
        "bitrate_kbps": {
          "const": 192
        },
        "integrated_lufs": {
          "type": "number",
          "minimum": -17.7,
          "maximum": -16.3
        },
        "true_peak_dbtp": {
          "type": "number",
          "maximum": -0.7
        },
        "contains_voice": {
          "const": false
        },
        "mix_config": {
          "type": "string",
          "pattern": "^config/T2_complete_voice_mix_v1_0_0_[A-D]\\.json$"
        },
        "mix_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "production_output_file": {
          "type": "string",
          "pattern": "^VIDEO_T2_COMPLET_VOIX_.*\\.mp4$"
        }
      }
    }
  }
}
