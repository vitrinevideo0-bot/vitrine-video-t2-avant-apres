{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrine.video/schemas/T2/render_job.schema.json",
  "title": "T2 Avant / Après — RenderJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "idempotency_key",
    "template_id",
    "template_version",
    "execution_profile",
    "network_policy",
    "merchant_payload",
    "captures",
    "capture_manifest",
    "runtime_contract",
    "text_motion_config",
    "audio_contract",
    "audio_mode",
    "render_stage",
    "render_business_text",
    "render_audio",
    "output"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 120},
    "template_id": {"const": "restaurants_maquis_T2_avant_apres_v0_1_0"},
    "template_version": {"const": "0.1.0"},
    "execution_profile": {
      "enum": ["T2_GITHUB_ACTIONS_SILENT", "T2_GITHUB_ACTIONS_TEXT_MOTION"]
    },
    "network_policy": {"const": "declared_sources_only"},
    "merchant_payload": {"$ref": "#/$defs/merchantPayload"},
    "captures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["S1", "S2", "S3", "S4"],
      "properties": {
        "S1": {"$ref": "#/$defs/captureS1"},
        "S2": {"$ref": "#/$defs/captureS2"},
        "S3": {"$ref": "#/$defs/captureS3"},
        "S4": {"$ref": "#/$defs/captureS4"}
      }
    },
    "capture_manifest": {"const": "rushes/manifest.json"},
    "runtime_contract": {"const": "config/T2_runtime_contract_v0_3_0.json"},
    "text_motion_config": {
      "type": ["string", "null"]
    },
    "audio_contract": {"$ref": "#/$defs/audioContract"},
    "audio_mode": {"const": "silent_no_audio_stream"},
    "render_stage": {
      "enum": ["silent_transition_validation", "dynamic_text_validation"]
    },
    "render_business_text": {"type": "boolean"},
    "render_audio": {"const": false},
    "output": {"$ref": "#/$defs/output"}
  },
  "allOf": [
    {
      "if": {"properties": {"render_stage": {"const": "silent_transition_validation"}}},
      "then": {
        "properties": {
          "execution_profile": {"const": "T2_GITHUB_ACTIONS_SILENT"},
          "render_business_text": {"const": false},
          "text_motion_config": {"const": null},
          "output": {
            "properties": {
              "uri": {"const": "output/T2_AVANT_APRES_TRANSITIONS_SILENT_V0_2_0.mp4"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"render_stage": {"const": "dynamic_text_validation"}}},
      "then": {
        "properties": {
          "execution_profile": {"const": "T2_GITHUB_ACTIONS_TEXT_MOTION"},
          "render_business_text": {"const": true},
          "text_motion_config": {"const": "config/T2_text_motion_v0_3_0.json"},
          "output": {
            "properties": {
              "uri": {"const": "output/T2_AVANT_APRES_TEXTES_DYNAMIQUES_V0_3_0.mp4"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "merchantPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nom", "produit", "prix", "whatsapp", "quartier"],
      "properties": {
        "nom": {"type": "string", "minLength": 1, "maxLength": 40},
        "produit": {"type": "string", "minLength": 1, "maxLength": 32},
        "prix": {"type": "string", "minLength": 1, "maxLength": 7, "pattern": "^[0-9 .]+$"},
        "whatsapp": {"type": "string", "minLength": 4, "maxLength": 20},
        "quartier": {"type": "string", "minLength": 1, "maxLength": 40},
        "accroche": {"type": "string", "minLength": 0, "maxLength": 48}
      }
    },
    "captureBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "duration_ms", "source_in_ms", "has_audio", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "integer", "minimum": 1},
        "source_in_ms": {"type": "integer", "minimum": 0},
        "has_audio": {"type": "boolean"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "captureS1": {
      "allOf": [
        {"$ref": "#/$defs/captureBase"},
        {"properties": {"duration_ms": {"const": 6000}}}
      ]
    },
    "captureS2": {
      "allOf": [
        {"$ref": "#/$defs/captureBase"},
        {"properties": {"duration_ms": {"const": 8000}}}
      ]
    },
    "captureS3": {
      "allOf": [
        {"$ref": "#/$defs/captureBase"},
        {"properties": {"duration_ms": {"const": 7000}}}
      ]
    },
    "captureS4": {
      "allOf": [
        {"$ref": "#/$defs/captureBase"},
        {"properties": {"duration_ms": {"const": 9000}}}
      ]
    },
    "audioContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_voice_mode",
        "preserve_captured_voice",
        "source_speed",
        "source_time_map",
        "audio_time_map",
        "automatic_subtitles",
        "current_output_audio",
        "music_status",
        "future_mix"
      ],
      "properties": {
        "capture_voice_mode": {"const": "optional_per_scene"},
        "preserve_captured_voice": {"const": true},
        "source_speed": {"const": 1.0},
        "source_time_map": {"const": "identity"},
        "audio_time_map": {"const": "identity"},
        "automatic_subtitles": {"const": false},
        "current_output_audio": {"const": false},
        "music_status": {"const": "deferred_until_visual_and_music_approval"},
        "future_mix": {"const": "captured_voice_plus_selected_T2_music_with_ducking"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "container",
        "video_mime",
        "width",
        "height",
        "fps",
        "frames",
        "duration_ms",
        "target_video_bitrate_bps",
        "overwrite"
      ],
      "properties": {
        "uri": {
          "enum": [
            "output/T2_AVANT_APRES_TRANSITIONS_SILENT_V0_2_0.mp4",
            "output/T2_AVANT_APRES_TEXTES_DYNAMIQUES_V0_3_0.mp4"
          ]
        },
        "container": {"const": "mp4"},
        "video_mime": {"const": "video/avc"},
        "width": {"const": 720},
        "height": {"const": 1280},
        "fps": {"const": 30},
        "frames": {"const": 900},
        "duration_ms": {"const": 30000},
        "target_video_bitrate_bps": {"type": "integer", "minimum": 4000000, "maximum": 6000000},
        "overwrite": {"const": true}
      }
    }
  }
}
