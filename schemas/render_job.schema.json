{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrine.video/schemas/T2/render_job.schema.json",
  "title": "T2 Avant / Après — RenderJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "idempotency_key",
    "template_id",
    "template_version",
    "execution_profile",
    "network_policy",
    "merchant_payload",
    "captures",
    "capture_manifest",
    "runtime_contract",
    "text_motion_config",
    "audio_contract",
    "audio_mode",
    "render_stage",
    "render_business_text",
    "render_audio",
    "output"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "template_id": {
      "const": "restaurants_maquis_T2_avant_apres_v0_1_0"
    },
    "template_version": {
      "const": "0.1.0"
    },
    "execution_profile": {
      "enum": [
        "T2_GITHUB_ACTIONS_SILENT",
        "T2_GITHUB_ACTIONS_TEXT_MOTION",
        "T2_GITHUB_ACTIONS_COMPLETE"
      ]
    },
    "network_policy": {
      "const": "declared_sources_only"
    },
    "merchant_payload": {
      "$ref": "#/$defs/merchantPayload"
    },
    "captures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "S1",
        "S2",
        "S3",
        "S4"
      ],
      "properties": {
        "S1": {
          "$ref": "#/$defs/captureS1"
        },
        "S2": {
          "$ref": "#/$defs/captureS2"
        },
        "S3": {
          "$ref": "#/$defs/captureS3"
        },
        "S4": {
          "$ref": "#/$defs/captureS4"
        }
      }
    },
    "capture_manifest": {
      "type": "string",
      "minLength": 1
    },
    "runtime_contract": {
      "enum": [
        "config/T2_runtime_contract_v0_3_0.json",
        "config/T2_runtime_contract_v0_6_0.json",
        "config/T2_runtime_contract_v0_7_0.json",
        "config/T2_runtime_contract_v1_0_0.json"
      ]
    },
    "text_motion_config": {
      "type": [
        "string",
        "null"
      ]
    },
    "audio_contract": {
      "$ref": "#/$defs/audioContract"
    },
    "audio_mode": {
      "enum": [
        "silent_no_audio_stream",
        "voice_music_ducking"
      ]
    },
    "render_stage": {
      "enum": [
        "silent_transition_validation",
        "dynamic_text_validation",
        "complete_voice_music_render"
      ]
    },
    "render_business_text": {
      "type": "boolean"
    },
    "render_audio": {
      "type": "boolean"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "capture_flow_contract": {
      "const": "config/T2_capture_flow_v1_0_0.json"
    },
    "visual_plan": {
      "$ref": "#/$defs/visualPlan"
    },
    "audio_plan": {
      "$ref": "#/$defs/audioPlan"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "render_stage": {
            "const": "silent_transition_validation"
          }
        }
      },
      "then": {
        "properties": {
          "execution_profile": {
            "const": "T2_GITHUB_ACTIONS_SILENT"
          },
          "render_business_text": {
            "const": false
          },
          "text_motion_config": {
            "const": null
          },
          "output": {
            "properties": {
              "uri": {
                "const": "output/T2_AVANT_APRES_TRANSITIONS_SILENT_V0_2_0.mp4"
              }
            }
          },
          "schema_version": {
            "const": "1.0.0"
          },
          "capture_manifest": {
            "const": "rushes/manifest.json"
          },
          "audio_mode": {
            "const": "silent_no_audio_stream"
          },
          "render_audio": {
            "const": false
          },
          "runtime_contract": {
            "const": "config/T2_runtime_contract_v0_3_0.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "render_stage": {
            "const": "dynamic_text_validation"
          }
        }
      },
      "then": {
        "properties": {
          "execution_profile": {
            "const": "T2_GITHUB_ACTIONS_TEXT_MOTION"
          },
          "render_business_text": {
            "const": true
          },
          "text_motion_config": {
            "const": "config/T2_text_motion_v0_3_0.json"
          },
          "output": {
            "properties": {
              "uri": {
                "const": "output/T2_AVANT_APRES_TEXTES_DYNAMIQUES_V0_3_0.mp4"
              }
            }
          },
          "schema_version": {
            "const": "1.0.0"
          },
          "capture_manifest": {
            "const": "rushes/manifest.json"
          },
          "audio_mode": {
            "const": "silent_no_audio_stream"
          },
          "render_audio": {
            "const": false
          },
          "runtime_contract": {
            "const": "config/T2_runtime_contract_v0_3_0.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "render_stage": {
            "const": "complete_voice_music_render"
          }
        },
        "required": [
          "render_stage"
        ]
      },
      "then": {
        "required": [
          "capture_flow_contract",
          "visual_plan",
          "audio_plan",
          "provenance"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          },
          "execution_profile": {
            "const": "T2_GITHUB_ACTIONS_COMPLETE"
          },
          "capture_manifest": {
            "anyOf": [
              {
                "const": "rushes/manifest.json"
              },
              {
                "pattern": "^rushes/runtime/[A-Za-z0-9._/-]+\\.json$"
              }
            ]
          },
          "render_business_text": {
            "const": true
          },
          "text_motion_config": {
            "const": "config/T2_text_motion_v0_3_0.json"
          },
          "audio_mode": {
            "const": "voice_music_ducking"
          },
          "render_audio": {
            "const": true
          },
          "captures": {
            "properties": {
              "S1": {
                "$ref": "#/$defs/captureS1Complete"
              },
              "S2": {
                "$ref": "#/$defs/captureS2Complete"
              },
              "S3": {
                "$ref": "#/$defs/captureS3Complete"
              },
              "S4": {
                "$ref": "#/$defs/captureS4Complete"
              }
            }
          },
          "audio_contract": {
            "required": [
              "voice_source_mode"
            ],
            "properties": {
              "current_output_audio": {
                "const": true
              },
              "music_status": {
                "enum": [
                  "selected_for_single_validation_exemplar",
                  "selected_for_current_production",
                  "selected_from_owner_approved_four_track_rotation"
                ]
              },
              "future_mix": {
                "const": "active_voice_plus_selected_T2_music_with_ducking"
              },
              "voice_source_mode": {
                "enum": [
                  "registered_voice_clips",
                  "captured_scene_audio",
                  "captured_or_registered_fallback"
                ]
              }
            }
          },
          "output": {
            "required": [
              "audio_sample_rate_hz",
              "audio_channels",
              "target_audio_bitrate_bps"
            ],
            "properties": {
              "uri": {
                "anyOf": [
                  {
                    "enum": [
                      "output/t2-complete-v0.6.0/VIDEO_T2_COMPLET_VOIX_MUSIQUE_B_A_VALIDER.mp4",
                      "output/t2-complete-v0.7.0/VIDEO_T2_COMPLET_VOIX_AFROFIRE_A_VALIDER.mp4"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^output/runtime/[A-Za-z0-9._-]+/VIDEO_T2_COMPLET_VOIX_[A-Z0-9_]+\\.mp4$"
                  }
                ]
              }
            }
          },
          "runtime_contract": {
            "enum": [
              "config/T2_runtime_contract_v0_6_0.json",
              "config/T2_runtime_contract_v0_7_0.json",
              "config/T2_runtime_contract_v1_0_0.json"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "audio_plan": {
            "properties": {
              "config": {
                "const": "config/T2_complete_voice_mix_v0_5_0.json"
              }
            },
            "required": [
              "config"
            ]
          }
        },
        "required": [
          "audio_plan"
        ]
      },
      "then": {
        "properties": {
          "runtime_contract": {
            "const": "config/T2_runtime_contract_v0_6_0.json"
          },
          "audio_contract": {
            "properties": {
              "music_status": {
                "const": "selected_for_single_validation_exemplar"
              }
            }
          },
          "output": {
            "properties": {
              "uri": {
                "const": "output/t2-complete-v0.6.0/VIDEO_T2_COMPLET_VOIX_MUSIQUE_B_A_VALIDER.mp4"
              }
            }
          },
          "audio_plan": {
            "properties": {
              "config": {
                "const": "config/T2_complete_voice_mix_v0_5_0.json"
              },
              "config_sha256": {
                "const": "6f58c9fbbd4f9305ba9a2f46e84a002db5577499f94e6933a0f8fc54cec620db"
              },
              "publication": {
                "properties": {
                  "output_file": {
                    "const": "VIDEO_T2_COMPLET_VOIX_MUSIQUE_B_A_VALIDER.mp4"
                  }
                }
              },
              "music": {
                "properties": {
                  "selection_mode": {
                    "const": "explicit_user_choice"
                  },
                  "requested_candidate_id": {
                    "const": "B"
                  },
                  "source_page": {
                    "const": "https://pixabay.com/music/afrobeat-afro-pop-vlog-sunshine-573643/"
                  },
                  "source_audio_url": {
                    "const": "https://cdn.pixabay.com/download/audio/2026/07/25/audio_f820d61128.mp3?filename=alex-morgan-afro-pop-vlog-sunshine-573643.mp3"
                  },
                  "source_sha256": {
                    "const": "1f137af6975816230a2a56b5995d23cf162cfe1256422675cb4b1c0638d1d3ec"
                  },
                  "content_id_status": {
                    "const": "registered"
                  },
                  "selected_candidate_id": {
                    "const": "B"
                  }
                },
                "required": [
                  "selected_candidate_id"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "audio_plan": {
            "properties": {
              "config": {
                "const": "config/T2_complete_voice_mix_v0_7_0.json"
              }
            },
            "required": [
              "config"
            ]
          }
        },
        "required": [
          "audio_plan"
        ]
      },
      "then": {
        "properties": {
          "runtime_contract": {
            "const": "config/T2_runtime_contract_v0_7_0.json"
          },
          "audio_contract": {
            "properties": {
              "music_status": {
                "const": "selected_for_current_production"
              }
            }
          },
          "output": {
            "properties": {
              "uri": {
                "const": "output/t2-complete-v0.7.0/VIDEO_T2_COMPLET_VOIX_AFROFIRE_A_VALIDER.mp4"
              }
            }
          },
          "audio_plan": {
            "properties": {
              "config": {
                "const": "config/T2_complete_voice_mix_v0_7_0.json"
              },
              "config_sha256": {
                "const": "0f5dd52b4340d34453f212a4b2c4d7dd5760d915525f94d8a3831ee5db021d3e"
              },
              "publication": {
                "properties": {
                  "output_file": {
                    "const": "VIDEO_T2_COMPLET_VOIX_AFROFIRE_A_VALIDER.mp4"
                  }
                }
              },
              "music": {
                "properties": {
                  "selection_mode": {
                    "const": "explicit_user_choice"
                  },
                  "requested_candidate_id": {
                    "const": "D"
                  },
                  "source_page": {
                    "const": "https://pixabay.com/music/afrobeat-afrofire-300338/"
                  },
                  "source_audio_url": {
                    "const": "https://cdn.pixabay.com/download/audio/2025/02/12/audio_bf52f1c5ad.mp3?filename=dpstudiomusic-afrofire-300338.mp3"
                  },
                  "source_sha256": {
                    "const": "24e9606e14e4708e8c8ffa3a6a97429dbfc95049d388481392d72b971e932c61"
                  },
                  "content_id_status": {
                    "const": "not_displayed_on_source_page"
                  },
                  "selected_candidate_id": {
                    "const": "D"
                  }
                },
                "required": [
                  "selected_candidate_id"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "audio_plan": {
            "properties": {
              "config": {
                "enum": [
                  "config/T2_complete_voice_mix_v1_0_0_A.json",
                  "config/T2_complete_voice_mix_v1_0_0_B.json",
                  "config/T2_complete_voice_mix_v1_0_0_C.json",
                  "config/T2_complete_voice_mix_v1_0_0_D.json"
                ]
              }
            },
            "required": [
              "config"
            ]
          }
        },
        "required": [
          "audio_plan"
        ]
      },
      "then": {
        "properties": {
          "runtime_contract": {
            "const": "config/T2_runtime_contract_v1_0_0.json"
          },
          "audio_contract": {
            "properties": {
              "music_status": {
                "const": "selected_from_owner_approved_four_track_rotation"
              }
            }
          },
          "output": {
            "properties": {
              "uri": {
                "type": "string",
                "pattern": "^output/runtime/[A-Za-z0-9._-]+/VIDEO_T2_COMPLET_VOIX_[A-Z0-9_]+\\.mp4$"
              }
            }
          },
          "audio_plan": {
            "properties": {
              "music": {
                "required": [
                  "owner_approved",
                  "last_successful_music_id",
                  "state_update_policy",
                  "source_bytes",
                  "file",
                  "sha256",
                  "bytes",
                  "duration_s",
                  "sample_rate_hz",
                  "channels",
                  "contains_voice"
                ],
                "properties": {
                  "owner_approved": {
                    "const": true
                  },
                  "last_successful_music_id": {
                    "enum": [
                      null,
                      "A",
                      "B",
                      "C",
                      "D"
                    ]
                  },
                  "state_update_policy": {
                    "const": "after_success_only"
                  },
                  "source_bytes": {
                    "type": "integer",
                    "minimum": 100000
                  },
                  "content_id_status": {
                    "const": "not_displayed_on_source_page"
                  },
                  "contains_voice": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "merchantPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nom",
        "produit",
        "prix",
        "whatsapp",
        "quartier"
      ],
      "properties": {
        "nom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "produit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "prix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 7,
          "pattern": "^[0-9 .]+$"
        },
        "whatsapp": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "quartier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "accroche": {
          "type": "string",
          "minLength": 0,
          "maxLength": 48
        }
      }
    },
    "captureBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "duration_ms",
        "source_in_ms",
        "has_audio",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "source_in_ms": {
          "type": "integer",
          "minimum": 0
        },
        "has_audio": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime_type": {
          "enum": [
            "video/mp4",
            "video/webm",
            "video/quicktime"
          ]
        },
        "video_codec": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 320
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "rotation_degrees": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "audio_codec": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "captureS1": {
      "allOf": [
        {
          "$ref": "#/$defs/captureBase"
        },
        {
          "properties": {
            "duration_ms": {
              "const": 6000
            }
          }
        }
      ]
    },
    "captureS2": {
      "allOf": [
        {
          "$ref": "#/$defs/captureBase"
        },
        {
          "properties": {
            "duration_ms": {
              "const": 8000
            }
          }
        }
      ]
    },
    "captureS3": {
      "allOf": [
        {
          "$ref": "#/$defs/captureBase"
        },
        {
          "properties": {
            "duration_ms": {
              "const": 7000
            }
          }
        }
      ]
    },
    "captureS4": {
      "allOf": [
        {
          "$ref": "#/$defs/captureBase"
        },
        {
          "properties": {
            "duration_ms": {
              "const": 9000
            }
          }
        }
      ]
    },
    "audioContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_voice_mode",
        "preserve_captured_voice",
        "source_speed",
        "source_time_map",
        "audio_time_map",
        "automatic_subtitles",
        "current_output_audio",
        "music_status",
        "future_mix"
      ],
      "properties": {
        "capture_voice_mode": {
          "const": "optional_per_scene"
        },
        "preserve_captured_voice": {
          "const": true
        },
        "source_speed": {
          "const": 1.0
        },
        "source_time_map": {
          "const": "identity"
        },
        "audio_time_map": {
          "const": "identity"
        },
        "automatic_subtitles": {
          "const": false
        },
        "current_output_audio": {
          "type": "boolean"
        },
        "music_status": {
          "enum": [
            "deferred_until_visual_and_music_approval",
            "selected_for_single_validation_exemplar",
            "selected_for_current_production",
            "selected_from_owner_approved_four_track_rotation"
          ]
        },
        "future_mix": {
          "enum": [
            "captured_voice_plus_selected_T2_music_with_ducking",
            "active_voice_plus_selected_T2_music_with_ducking"
          ]
        },
        "voice_source_mode": {
          "enum": [
            "registered_voice_clips",
            "captured_scene_audio",
            "captured_or_registered_fallback"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "container",
        "video_mime",
        "width",
        "height",
        "fps",
        "frames",
        "duration_ms",
        "target_video_bitrate_bps",
        "overwrite"
      ],
      "properties": {
        "uri": {
          "anyOf": [
            {
              "enum": [
                "output/T2_AVANT_APRES_TEXTES_DYNAMIQUES_V0_3_0.mp4",
                "output/T2_AVANT_APRES_TRANSITIONS_SILENT_V0_2_0.mp4",
                "output/t2-complete-v0.6.0/VIDEO_T2_COMPLET_VOIX_MUSIQUE_B_A_VALIDER.mp4",
                "output/t2-complete-v0.7.0/VIDEO_T2_COMPLET_VOIX_AFROFIRE_A_VALIDER.mp4"
              ]
            },
            {
              "type": "string",
              "pattern": "^output/runtime/[A-Za-z0-9._-]+/VIDEO_T2_COMPLET_VOIX_[A-Z0-9_]+\\.mp4$"
            }
          ]
        },
        "container": {
          "const": "mp4"
        },
        "video_mime": {
          "const": "video/avc"
        },
        "width": {
          "const": 720
        },
        "height": {
          "const": 1280
        },
        "fps": {
          "const": 30
        },
        "frames": {
          "const": 900
        },
        "duration_ms": {
          "const": 30000
        },
        "target_video_bitrate_bps": {
          "type": "integer",
          "minimum": 4000000,
          "maximum": 6000000
        },
        "overwrite": {
          "const": true
        },
        "audio_sample_rate_hz": {
          "const": 48000
        },
        "audio_channels": {
          "const": 2
        },
        "target_audio_bitrate_bps": {
          "const": 192000
        }
      }
    },
    "captureS1Complete": {
      "allOf": [
        {
          "$ref": "#/$defs/captureS1"
        },
        {
          "required": [
            "mime_type",
            "video_codec",
            "width",
            "height",
            "fps",
            "frame_count",
            "rotation_degrees",
            "audio_codec"
          ]
        }
      ]
    },
